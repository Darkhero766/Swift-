{
  "manifest_version": 3,
  "name": "Glass Toast",
  "version": "1.1.0",
  "description": "A discreet frosted-glass partner perk notification on the pages you browse.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["data.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
